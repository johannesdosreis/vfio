#!/usr/bin/env bash
# Start Sunshine with the encoder that fits where the NVIDIA dGPU is right now:
#   on the host (nvidia driver)    -> Sunshine picks NVENC itself
#   with the win11 VM (vfio-pci)   -> force VAAPI on the Intel iGPU (adapter_name in sunshine.conf);
#                                     auto-probing without the dGPU crashes inside libcuda
# The libvirt hook (vfio-dgpu) restarts Sunshine whenever the dGPU changes hands.
d=$(readlink /sys/bus/pci/devices/0000:01:00.0/driver 2>/dev/null)
if [[ ${d##*/} == nvidia ]]; then
  exec /usr/bin/sunshine "$@"
fi
exec /usr/bin/sunshine "$@" encoder=vaapi
