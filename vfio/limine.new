ESP_PATH="/boot"
KERNEL_CMDLINE[default]+="quiet nowatchdog splash rw rootflags=subvol=/@ root=UUID=9f88347f-55f7-4b02-8a4c-c05d52a16bad systemd.zram=0 zswap.enabled=1 zswap.shrinker_enabled=1 zswap.compressor=lz4 zswap.max_pool_percent=30 intel_iommu=on iommu=pt"
BOOT_ORDER="*, *lts, *fallback, Snapshots"
